#
# systemd --user unit for mcpmux. Install to ~/.config/systemd/user/mcpmux.service
# (the `make install` target does this).
#
# Two ways to run it (both use the socket so restarts never drop connections):
#
#   A) Always-on (recommended when you have interactive OAuth backends like
#      Linear): the service authenticates once at startup and stays running.
#        systemctl --user daemon-reload
#        systemctl --user enable --now mcpmux.socket mcpmux.service
#
#   B) On-demand (only if ALL backends are non-interactive): enable just the
#      socket; the service starts on the first connection.
#        systemctl --user enable --now mcpmux.socket
#
#   journalctl --user -u mcpmux -f       # watch logs / OAuth URLs
#
# A backend whose credential was unavailable at startup is retried in the
# background (see `connect_retry` in the config) and logged as "backend
# pending". After refreshing the credential, bring those backends up at once
# without a restart -- a restart would re-trigger every interactive OAuth
# consent, and would drop live client sessions:
#
#   systemctl --user kill -s USR1 mcpmux
#
# Running mcpmux as a long-lived user service is the point: you authenticate
# backends once, and every Claude Code session reuses the daemon's live tokens
# instead of re-authenticating per session.

[Unit]
Description=mcpmux - MCP multiplexer (one endpoint proxying multiple MCP servers)
Requires=mcpmux.socket
# Order after graphical-session.target so the desktop has already imported
# DISPLAY/WAYLAND_DISPLAY/XAUTHORITY into the systemd --user environment before
# mcpmux starts. A process's env is frozen at exec, so starting earlier means
# interactive OAuth backends inherit no display and xdg-open silently no-ops.
After=mcpmux.socket network-online.target graphical-session.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
# Type=notify: mcpmux signals readiness (sd_notify READY=1) once the
# non-interactive backends are connected and it is serving. Interactive OAuth
# backends authorize in the background afterwards (registering their tools as
# each consent completes), so a slow/forgotten browser consent never blocks
# readiness or trips TimeoutStartSec.
Type=notify
NotifyAccess=main
# Reads ~/.config/mcpmux/config.yaml by default; uses the socket from mcpmux.socket.
# --log-level debug logs the full per-tool catalog at startup and every client
# request. Drop it (back to the default info level) if the journal gets noisy.
# Optional file holding secrets referenced as ${VAR} in the config (e.g. an
# OAuth client_id/client_secret for a backend whose server needs a pre-registered
# client). The leading "-" makes it optional. Keep it out of version control and
# chmod 600 — it is NOT part of the (symlinked) config.
EnvironmentFile=-%h/.config/mcpmux/mcpmux.env
# systemd's minimal PATH omits per-user bin dirs; prepend them so auth token
# commands (e.g. the cg-* backends' `chainctl`) resolve instead of being skipped.
Environment=PATH=%h/bin:%h/.local/bin:/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
# Run the binary `make install` installs (default PREFIX=~/.local), not one
# resolved from PATH: a stale `go install` copy in $GOPATH/bin would otherwise
# shadow it and every reinstall would keep running the old code. Adjust the path
# if you install with a different PREFIX.
ExecStart=%h/.local/bin/mcpmux serve --log-level debug
Restart=on-failure
RestartSec=5
# Allow time for an interactive browser authorization (e.g. Linear) at startup.
# Slightly longer than mcpmux's own oauthConnectTimeout (10m) so that an
# unapproved backend is skipped gracefully rather than the service being killed.
TimeoutStartSec=660

# Interactive OAuth backends (auth.type: oauth) open a browser at startup. The
# After=/PartOf=graphical-session.target ordering above ensures the graphical
# session's environment is already imported when mcpmux starts, so xdg-open has
# a display. mcpmux launches the opener in its own transient systemd scope, so
# this unit's cgroup kill on restart does not take the browser down with it.
# If your desktop does not populate the systemd --user environment,
# either run once after login:
#   systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS
# or set `open_browser: false` on those backends and click the URL shown in
# `journalctl --user -u mcpmux`.

[Install]
WantedBy=graphical-session.target
